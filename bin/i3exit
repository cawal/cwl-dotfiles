#!/bin/sh
lock() {
    # Using i3lock-color (NixOS: better PAM support)
    # Simple black screen lock
    i3lock-color -c 000000
    
    # Alternative with blur effect (uncomment if preferred):
    # i3lock-color --blur 5 --clock --indicator --time-str="%H:%M:%S"
}

case "$1" in
    lock)
        lock
        ;;
    logout)
        i3 exit
        ;;
    suspend)
        lock && systemctl suspend
        ;;
    hibernate)
        lock && systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        systemctl halt
	;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
