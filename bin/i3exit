#!/bin/sh
# Ações de sessão para o qtile (chamado como `i3exit lock|suspend|...`).

# Bloqueia a tela com o betterlockscreen (i3lock-color, efeito blur).
# 1ª vez / trocar a imagem: betterlockscreen -u /caminho/wallpaper (gera cache).
lock() {
    betterlockscreen --lock blur
}

# Bloqueia a tela DE FORMA ASSÍNCRONA e só então dorme. O betterlockscreen roda
# o i3lock em foreground (bloqueia até o desbloqueio); por isso o antigo
# `lock && systemctl suspend` só suspendia DEPOIS de destravar. Aqui o lock vai
# para segundo plano (setsid, sobrevive à saída deste script) e esperamos o
# i3lock realmente subir antes de suspender/hibernar — evitando também que a
# área de trabalho apareça por um instante ao religar.
lock_then() {
    setsid betterlockscreen --lock blur >/dev/null 2>&1 &
    # aguarda o i3lock efetivamente no ar (até ~3s) antes de dormir
    i=0
    while [ "$i" -lt 30 ]; do
        pgrep -x i3lock >/dev/null 2>&1 && break
        sleep 0.1
        i=$((i + 1))
    done
    systemctl "$1"
}

case "$1" in
    lock)       lock ;;
    logout)     i3 exit ;;
    suspend)    lock_then suspend ;;
    hibernate)  lock_then hibernate ;;
    reboot)     systemctl reboot ;;
    shutdown)   systemctl halt ;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
