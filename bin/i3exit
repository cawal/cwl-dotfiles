#!/bin/sh
lock() {
    # Using xsecurelock (NixOS: most reliable screen locker)
    # More secure and better PAM support than i3lock
    env XSECURELOCK_BLANK_TIMEOUT=5 \
        XSECURELOCK_BLANK_DPMS_STATE=off \
        XSECURELOCK_AUTH_BACKGROUND_COLOR="#000000" \
        xsecurelock
}

case "$1" in
    lock)
        lock
        ;;
    logout)
        i3 exit
        ;;
    suspend)
        lock && systemctl suspend
        ;;
    hibernate)
        lock && systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        systemctl halt
	;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
