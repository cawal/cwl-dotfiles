#!/bin/sh
lock() {
    # Using betterlockscreen (works on any WM/DE)
    # Wrapper around i3lock with better configuration
    # First run: betterlockscreen -u /path/to/wallpaper (to cache)
    betterlockscreen --lock blur
}

case "$1" in
    lock)
        lock
        ;;
    logout)
        i3 exit
        ;;
    suspend)
        lock && systemctl suspend
        ;;
    hibernate)
        lock && systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        systemctl halt
	;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
