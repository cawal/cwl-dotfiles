#!/bin/sh
lock() {
    # Using loginctl (native system lock - works with GDM/GNOME)
    # Most reliable: uses the same lock screen you see at login
    loginctl lock-session
}

case "$1" in
    lock)
        lock
        ;;
    logout)
        i3 exit
        ;;
    suspend)
        lock && systemctl suspend
        ;;
    hibernate)
        lock && systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown)
        systemctl halt
	;;
    *)
        echo "Usage: $0 {lock|logout|suspend|hibernate|reboot|shutdown}"
        exit 2
esac

exit 0
